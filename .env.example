# Copy to .env.local and fill in with your Firebase project's web config
# (Firebase console → Project settings → Your apps → Web app → SDK setup and configuration).
# These values are public by design; access is protected by firestore.rules and tablet pairing.
# If they are left empty the app runs in DEMO mode: data is stored only on this device.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
