rules_version = '2';

// Access model (no login, no pairing): every tablet signs in anonymously and invisibly, and
// any signed-in client can read and edit the menu. The edit PIN is only checked on the tablet.
// These rules keep out unauthenticated scripts and malformed or oversized documents.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    function deleting() {
      return request.method == 'delete';
    }

    match /config/app {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['pinHash', 'pinSalt'])
        && shortString(request.resource.data.pinHash, 128)
        && shortString(request.resource.data.pinSalt, 64);
    }

    function sizeIn(value, lo, hi) {
      return value is number && value >= lo && value <= hi;
    }

    // Interface sizes from the admin panel, shared by every tablet.
    match /config/ui {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['zoom', 'menjarTile', 'cardSize', 'cardSizeAll', 'cardTitle', 'detailImage', 'railWidth'])
        && sizeIn(request.resource.data.get('zoom', 100), 50, 200)
        && sizeIn(request.resource.data.get('menjarTile', 140), 50, 300)
        && sizeIn(request.resource.data.get('cardSize', 240), 100, 600)
        && sizeIn(request.resource.data.get('cardSizeAll', 288), 100, 600)
        && sizeIn(request.resource.data.get('cardTitle', 21), 8, 60)
        && sizeIn(request.resource.data.get('detailImage', 44), 10, 90)
        && sizeIn(request.resource.data.get('railWidth', 232), 100, 500);
    }

    match /info/restaurant {
      allow read: if signedIn();
      allow write: if signedIn() && (deleting() || shortString(request.resource.data.name, 200));
    }

    match /categories/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (deleting() || shortString(request.resource.data.name, 120));
    }

    match /dishes/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (deleting() || shortString(request.resource.data.name, 200));
    }

    match /drinks/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (deleting() || shortString(request.resource.data.name, 200));
    }

    match /guides/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (deleting() || shortString(request.resource.data.title, 200));
    }

    match /allergens/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (deleting() || shortString(request.resource.data.name, 60));
    }

    match /images/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (deleting() || shortString(request.resource.data.data, 1000000));
    }
  }
}
